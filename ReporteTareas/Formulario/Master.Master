    <%--    <script src="../../bower_components/jquery/dist/jquery.min.js"></script>--%>
    <script src="../bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="../bower_components/metisMenu/dist/metisMenu.min.js"></script>
    <script src="../bower_components/raphael/raphael-min.js"></script>
    <script src="../bower_components/morrisjs/morris.js"></script>
    <%-- <script src="../js/morris-data.js"></script>--%>
    <script src="../bower_components/assets/js/select2.min.js"></script>
    <script src="../bower_components/assets/js/bootstrap-multiselect.min.js"></script>
    <script src="../bower_components/assets/js/bootstrap-multiselect.min.js"></script>
    <script src="../dist/js/sb-admin-2.js"></script>
    <script src="../js/dos-menu.js?v=3"></script>
    <%-- Espera de las consultas, para TODAS las pantallas.

         75 pantallas usan esta master. Solo 51 cargaban blockUI, y 35 archivos
         de js registraban el ajaxStart por su cuenta; las 24 restantes no
         mostraban nada mientras esperaban. Registrarlo aca lo resuelve de una
         vez, sin tocar ninguna pantalla.

         Esto fija el mensaje por defecto. Las pantallas que definen el suyo lo
         hacen dentro de $(function(){...}), que corre despues de este bloque,
         asi que el de la pantalla gana. Aca solo se cubre a las que no tienen
         ninguno. --%>
    <script src="../js/jquery.blockUI.js"></script>
    <script>
        (function () {
            if (typeof jQuery === "undefined" || !jQuery.blockUI) { return; }

            jQuery.blockUI.defaults.message = "Espere un momento, por favor...";
            jQuery.blockUI.defaults.css = {};          /* el aspecto lo da dos-tema.css */
            jQuery.blockUI.defaults.overlayCSS = {};
            jQuery.blockUI.defaults.fadeOut = 120;

            /* De fabrica blockUI arranca en 1000, y con eso la capa quedaba
               DEBAJO de los modales de bootstrap, que van en 1050. Son 46 las
               pantallas con modal: si la consulta salia de adentro de uno, la
               espera no se veia. 2000 la deja encima del modal y por debajo de
               sweetalert (10000), que debe seguir mandando. */
            jQuery.blockUI.defaults.baseZ = 2000;

            /* El fadeIn se deja como viene la libreria (200 ms): las consultas
               cortas alcanzan a terminar antes de que la capa sea opaca, y asi
               no parpadea en cada llamada. */

            /* En las 51 pantallas que ya lo registraban quedan DOS manejadores
               y los dos corren en el mismo ajaxStart. No pasa nada: blockUI
               borra el bloqueo anterior antes de montar el nuevo
               (jquery.blockUI.js:268) y unblockUI dos veces no hace daño. El de
               la pantalla corre despues, asi que su mensaje es el que queda. */
            jQuery(document).ajaxStart(jQuery.blockUI).ajaxStop(jQuery.unblockUI);
        })();
    </script>
    <%-- Estado vacio: el bloque que se pinta cuando una consulta no trae filas.
         Va al pie porque solo se invoca desde callbacks de AJAX, nunca durante
         el parseo. El aspecto lo da dos-tema.css. --%>
    <script src="../js/dos-vacio.js?v=1"></script>
    <!-- Latest jQuery minified -->
