# Estado de la interfaz de Visual Studio (ventanas abiertas, breakpoints).
# Es por maquina y por usuario: no aporta nada al repo y ensucia el diff
# cada vez que se abre la solucion.
*.suo
.vs/**/suo*.tmp

# Configuracion por usuario y por maquina. Traen rutas locales y el puerto de
# IIS Express: si se commitean, le pisan la configuracion a cualquier otro que
# clone el repo, y ensucian el diff en cada sesion de trabajo.
*.user
.vs/**/applicationhost.config

# OJO: bin/ se trackea a proposito en este repo — el despliegue a produccion
# sale de ahi, igual que de ReporteTareas/obj/Release/Package/. Esos dos no
# se agregan aqui. Lo que sigue es solo lo que MSBuild regenera en cada build.

# Intermedios de compilacion. Son copias de lo que ya vive en bin/ mas
# archivos de trabajo del compilador: cambian en cada build y ensucian el
# diff sin aportar nada.
**/obj/Debug/
**/obj/Release/

# EXCEPCION: el paquete de despliegue a produccion vive dentro de obj/Release.
# Se re-incluye la carpeta y adentro solo se conserva Package/.
!ReporteTareas/obj/Release/
ReporteTareas/obj/Release/*
!ReporteTareas/obj/Release/Package/

# Simbolos de depuracion: no hacen falta para ejecutar la aplicacion.
*.pdb

# Blindaje: adentro del paquete de despliegue no se ignora nada, para que las
# reglas de arriba no puedan recortarlo por accidente.
!ReporteTareas/obj/Release/Package/PackageTmp/**

# El target Package deja ademas, sueltos en Package/, un .zip de ~150 MB y los
# scripts de MSDeploy. El despliegue de este proyecto no los usa: copia a mano
# el contenido de PackageTmp/. Se ignoran para que un `git add -A` distraido no
# meta el zip al repositorio. Solo aplican a Package/ en si, no a PackageTmp/.
ReporteTareas/obj/Release/Package/*.zip
ReporteTareas/obj/Release/Package/*.cmd
ReporteTareas/obj/Release/Package/*.xml
ReporteTareas/obj/Release/Package/*.txt

# Credenciales de base de datos. connections.config se crea a mano en cada
# maquina y en el servidor a partir de connections.config.ejemplo, que si
# se versiona. Nunca commitear el archivo con las contrasenas reales.
connections.config
