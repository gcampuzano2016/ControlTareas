                var palabras = nombreCompleto.Split(' ');

                // Asegurarse de que haya al menos cuatro palabras antes de acceder a los índices
                primerApellido = palabras.Length > 0 ? palabras[0] : "";
                segundoApellido = palabras.Length > 1 ? palabras[1] : "";
