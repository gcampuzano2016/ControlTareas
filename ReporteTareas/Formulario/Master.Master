    <link href="../css/dos-tema.css?v=10" rel="stylesheet" />
    <%-- Aplica la preferencia del menu ANTES del primer pintado. Si esto fuera
         al final del body, la barra lateral parpadearia en cada pantalla. --%>
    <script>
        try {
            if (window.localStorage.getItem("dosMenuOculto") === "1") {
                document.documentElement.className += " menu-oculto";
            }
        } catch (e) { }
    </script>
